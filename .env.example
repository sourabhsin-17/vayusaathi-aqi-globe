# GEMINI_API_KEY: Optional server-side key for personalized AI plans and assistant Q&A.
# Set this in Vercel Project Settings -> Environment Variables (never expose in VITE_* vars).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional override for the Gemini model ID used by /api/recommendations and /api/assistant.
# GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: Public deployment URL where the application is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Optional public browser-restricted Google Maps JavaScript API key.
# Leave unset to use the interactive 3D Earth globe without Google Maps street tiles.
# VITE_GOOGLE_MAPS_API_KEY=""
